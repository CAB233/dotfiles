# 与 abbr.fish 相反，变量不会被展开
# https://fishshell.com/docs/current/cmds/alias.html

# fish 配置相关变量
alias a 'abbr --add --global'
alias x 'set --global --export'

# 自定义部分
alias m micro
alias yarn 'yarn --use-yarnrc "$XDG_CONFIG_HOME/yarn/config"'
alias ls 'eza --time-style long-iso --modified --group-directories-first --icons=auto'

{{- if eq .chezmoi.osRelease.id "arch" }}
alias yay paru
{{- end }}

{{- if eq .chezmoi.osRelease.id "fedora" }}
alias up 'sudo dnf makecache --refresh && sudo dnf up'
{{- end }}

{{ if eq .profile "master" -}}
function c
    for cmd in code codium
        if type -q $cmd
            command $cmd $argv
            return
        end
    end

    echo "Neither code nor codium was found" >&2
    return 127
end
{{- end }}

function e
    for cmd in edit msedit
        if type -q $cmd
            command $cmd $argv
            return
        end
    end

    echo "Neither edit nor msedit was found" >&2
    return 127
end
